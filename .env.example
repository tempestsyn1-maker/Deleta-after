# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# BEYOND SERVER DEPLOYMENT & MIGRATION VARIABLES:
# Optional PostgreSQL connection string (Render Postgres or Cloud SQL)
DATABASE_URL="postgres://user:password@hostname:5432/beyond"

# Secret token required to access /api/admin/export-accounts and /api/admin/import-accounts
MIGRATION_ADMIN_SECRET="your-secure-migration-secret-token"

# Administrator Bootstrap Password (Minimum 16 characters)
# If provided, a fresh admin account "Aleph" will be created if it does not exist.
# ADMIN_BOOTSTRAP_PASSWORD="your-secure-admin-password-min-16-chars"

# CORS configuration: comma-separated list of allowed frontend origins
# If empty or not set, defaults to allowing all origins (less secure).
# ALLOWED_ORIGINS="https://beyond-rpg.com,http://localhost:3000"

# Set to "true" on old Oregon server during cutover to block mutations and notify players
MAINTENANCE_MODE="false"

# URL of new Singapore backend announced to players in Oregon maintenance mode
TARGET_SERVER_URL="https://beyond-game-sg.onrender.com"

# Set on Vercel or frontend client if pointing to an external Render backend
VITE_SERVER_URL="https://beyond-game-sg.onrender.com"
